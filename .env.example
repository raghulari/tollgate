# ==============================================================================
# TOLLGATE — PRODUCTION ENVIRONMENT TEMPLATE (.env.example)
#
# Copy this file to .env.local for development.
# NEVER commit .env or secrets to Git.
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=3000

# ------------------------------------------------------------------------------
# Supabase Configuration (Authentication & Persistent Database)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ------------------------------------------------------------------------------
# Upstash Redis (Rate Limiting, Hot Budgets, Worker Queue)
# ------------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-token
REDIS_URL=redis://default:your-token@your-redis.upstash.io:6379

# ------------------------------------------------------------------------------
# Tollgate Key Vault & Encryption (Envelope Encryption AES-256-GCM)
# KEK must be a 32-byte (64 hex characters) cryptographic key stored in KMS / Secret Manager.
# ------------------------------------------------------------------------------
TOLLGATE_MASTER_KEK=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ------------------------------------------------------------------------------
# AI Gateway Data Plane Configuration
# ------------------------------------------------------------------------------
GATEWAY_PORT=8787
GATEWAY_HOST=0.0.0.0
GATEWAY_CORS_ORIGINS=http://localhost:3000,https://app.tollgate.dev
GATEWAY_REDIS_FAIL_CLOSED=true
GATEWAY_REQUEST_TIMEOUT_MS=60000

# ------------------------------------------------------------------------------
# Background Processing (BullMQ Worker)
# ------------------------------------------------------------------------------
WORKER_CONCURRENCY=5
USAGE_BATCH_SIZE=50
USAGE_FLUSH_INTERVAL_MS=5000

# ------------------------------------------------------------------------------
# Internal Testing / Development AI Provider Credentials
# (For Tollgate platform self-testing only. Customer credentials are encrypted in vault)
# ------------------------------------------------------------------------------
GEMINI_TEST_API_KEY=
OPENAI_TEST_API_KEY=
ANTHROPIC_TEST_API_KEY=

# ------------------------------------------------------------------------------
# Observability & Monitoring
# ------------------------------------------------------------------------------
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=info
